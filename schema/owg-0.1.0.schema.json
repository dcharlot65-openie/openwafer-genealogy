{
  "$defs": {
    "Attribute": {
      "description": "A categorical value: a chemical, a resist name, a yes/no.",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object"
    },
    "Axis": {
      "description": "One axis of a measured curve.",
      "properties": {
        "derivation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Derivation"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Present when the axis was computed, not read: drain current from a series-resistor voltage."
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuantityKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "type": "string"
        },
        "unit": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "values": {
          "default": [],
          "items": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Bias": {
      "description": "The bias on one terminal during a test.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/BiasMode"
        },
        "terminal": {
          "description": "\"gate\", \"drain\", \"source\", \"body\", \"force+\", \"sense-\".",
          "type": "string"
        }
      },
      "required": [
        "terminal",
        "mode"
      ],
      "type": "object"
    },
    "BiasMode": {
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "fixed",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Quantity"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "start": {
              "$ref": "#/$defs/Quantity"
            },
            "step": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Quantity"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "stop": {
              "$ref": "#/$defs/Quantity"
            },
            "type": {
              "const": "sweep",
              "type": "string"
            }
          },
          "required": [
            "type",
            "start",
            "stop"
          ],
          "type": "object"
        }
      ]
    },
    "BinDef": {
      "description": "One bin code of a bin map.",
      "properties": {
        "code": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "pass": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "name",
        "pass"
      ],
      "type": "object"
    },
    "BinMap": {
      "description": "A wafer's sort result, after SEMI E142's bin map.",
      "properties": {
        "after_run": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "bin_defs": {
          "items": {
            "$ref": "#/$defs/BinDef"
          },
          "type": "array"
        },
        "dies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DieBin"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "license": {
          "anyOf": [
            {
              "$ref": "#/$defs/License"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "material": {
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "material",
        "bin_defs"
      ],
      "type": "object"
    },
    "CalStatus": {
      "oneOf": [
        {
          "const": "calibrated",
          "description": "Calibrated on `date` against `reference`.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "Never calibrated, or no record of it. Stated, not omitted.",
          "type": "string"
        },
        {
          "const": "not_applicable",
          "description": "A simulated sensor or a counter that has nothing to calibrate.",
          "type": "string"
        }
      ]
    },
    "Calibration": {
      "properties": {
        "date": {
          "default": null,
          "description": "`YYYY-MM-DD`; required when `status` is `calibrated`.",
          "type": [
            "string",
            "null"
          ]
        },
        "reference": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/CalStatus"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "Curve": {
      "description": "A raw curve: y against x at fixed other biases.",
      "properties": {
        "fixed": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Parameter"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "uncertainty": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uncertainty"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "x": {
          "$ref": "#/$defs/Axis"
        },
        "y": {
          "$ref": "#/$defs/Axis"
        }
      },
      "required": [
        "name",
        "x",
        "y"
      ],
      "type": "object"
    },
    "DeclaredOrigin": {
      "description": "What a whole dataset claims to contain.",
      "oneOf": [
        {
          "const": "MEASURED",
          "description": "Real fab records: MEASURED and SPECIFIED only. A SIMULATED record is an error.",
          "type": "string"
        },
        {
          "const": "SIMULATED",
          "description": "Simulation output: SIMULATED and SPECIFIED only. A MEASURED record is an error.",
          "type": "string"
        },
        {
          "const": "MIXED",
          "description": "Both, on purpose (for example virtual-metrology predictions about real wafers). Every\nquery result is labelled with the origins it touched.",
          "type": "string"
        }
      ]
    },
    "Defect": {
      "description": "One defect, or a count of a class of defects, found on a material unit.",
      "properties": {
        "after_run": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "class": {
          "description": "\"blister\", \"particle\", \"crack\", \"killer\".",
          "type": "string"
        },
        "count": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "license": {
          "anyOf": [
            {
              "$ref": "#/$defs/License"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "material": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/MapPosition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "size": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "material",
        "class",
        "method"
      ],
      "type": "object"
    },
    "Derivation": {
      "description": "How a derived value was computed.",
      "properties": {
        "inputs": {
          "default": [],
          "description": "Ids of the records (or names of the quantities) it was computed from.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "method": {
          "description": "The method, specific enough to reproduce: \"Rs = (π/ln 2)·mean(V/I), collinear 4PP\".",
          "type": "string"
        }
      },
      "required": [
        "method"
      ],
      "type": "object"
    },
    "DieBin": {
      "description": "One die's bin.",
      "properties": {
        "bin": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "die": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "index": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/MapPosition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "bin"
      ],
      "type": "object"
    },
    "ElectricalTest": {
      "description": "One electrical test of one structure.",
      "properties": {
        "at": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "attributes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Attribute"
          },
          "type": "array"
        },
        "bias": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Bias"
          },
          "type": "array"
        },
        "curves": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Curve"
          },
          "type": "array"
        },
        "extracted": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Extracted"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "instrument": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "anyOf": [
            {
              "$ref": "#/$defs/License"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "material": {
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "structure": {
          "description": "\"NMOS W/L\", \"collinear 4-point probe\", \"MOS capacitor\".",
          "type": "string"
        },
        "structure_params": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Parameter"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "material",
        "structure"
      ],
      "type": "object"
    },
    "Estimate": {
      "description": "A model estimate about some material: a defect-density posterior, a fitted parameter.\nIts quantity must carry a derivation.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuantityKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "license": {
          "anyOf": [
            {
              "$ref": "#/$defs/License"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parameter": {
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "scope": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "scope",
        "parameter",
        "quantity"
      ],
      "type": "object"
    },
    "Extracted": {
      "description": "An extracted parameter. Its quantity must carry a derivation: extraction is a method.",
      "properties": {
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuantityKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "type": "string"
        },
        "quantity": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "name",
        "quantity"
      ],
      "type": "object"
    },
    "GenealogyEvent": {
      "description": "A change to the hierarchy itself.",
      "properties": {
        "at": {
          "default": null,
          "description": "RFC 3339 time.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "inputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "license": {
          "anyOf": [
            {
              "$ref": "#/$defs/License"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "op": {
          "$ref": "#/$defs/GenealogyOp"
        },
        "outputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "run": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "op"
      ],
      "type": "object"
    },
    "GenealogyOp": {
      "oneOf": [
        {
          "const": "create",
          "description": "New material enters the fab (`outputs` only).",
          "type": "string"
        },
        {
          "const": "split",
          "description": "One unit becomes several: lot split, wafer cleaved into chips.",
          "type": "string"
        },
        {
          "const": "merge",
          "description": "Several units become one: lot merge.",
          "type": "string"
        },
        {
          "const": "rework",
          "description": "A step is redone on the same material; `run` names the run being redone.",
          "type": "string"
        },
        {
          "const": "scrap",
          "description": "Material leaves the fab (`inputs` only).",
          "type": "string"
        }
      ]
    },
    "Header": {
      "properties": {
        "created": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "dataset_id": {
          "type": "string"
        },
        "declared_origin": {
          "$ref": "#/$defs/DeclaredOrigin"
        },
        "description": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "schema": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schema_version",
        "dataset_id",
        "title",
        "declared_origin"
      ],
      "type": "object"
    },
    "License": {
      "description": "The licence a record may be redistributed under. Required on every record.",
      "properties": {
        "attribution": {
          "default": null,
          "description": "The attribution the licence requires.",
          "type": [
            "string",
            "null"
          ]
        },
        "spdx": {
          "description": "An SPDX licence expression (`CC-BY-4.0`, `CC0-1.0`, `CC-BY-SA-4.0 AND CERN-OHL-S-2.0`).\n`NOASSERTION` records that the licence is unknown: such records validate but are not\nredistributable and are dropped by `export --redistributable-only`.",
          "type": "string"
        },
        "url": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "spdx"
      ],
      "type": "object"
    },
    "MapPosition": {
      "description": "Position in a parent's map, after SEMI E142's substrate map (die index and coordinates).",
      "properties": {
        "origin": {
          "default": null,
          "description": "Where (0, 0) is: \"center\", \"lower_left\", \"notch_down_lower_left\" (E142 OriginLocation).",
          "type": [
            "string",
            "null"
          ]
        },
        "x": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "x_index": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "y": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "y_index": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "MaterialUnit": {
      "description": "One piece of material at one level of the hierarchy.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/UnitKind"
        },
        "label": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "anyOf": [
            {
              "$ref": "#/$defs/License"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parent": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/MapPosition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "site": {
          "default": null,
          "description": "The fab site that holds it.",
          "type": [
            "string",
            "null"
          ]
        },
        "substrate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Substrate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "MetroPoint": {
      "description": "One measured value at one place.",
      "properties": {
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/MapPosition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "site": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "Metrology": {
      "description": "A measurement of one parameter on one material unit, at one or more sites.",
      "properties": {
        "after_run": {
          "default": null,
          "description": "The process run whose result this measures.",
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "attributes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Attribute"
          },
          "type": "array"
        },
        "conditions": {
          "default": [],
          "description": "Measurement conditions: model assumptions (n = 1.6), temperature, probe spacing.",
          "items": {
            "$ref": "#/$defs/Parameter"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuantityKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "license": {
          "anyOf": [
            {
              "$ref": "#/$defs/License"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "material": {
          "type": "string"
        },
        "method": {
          "description": "\"XRR\", \"reflectometry\", \"profilometer\", \"QCM\", \"CD-SEM\", \"AFM\", \"4PP\", \"virtual metrology\".",
          "type": "string"
        },
        "parameter": {
          "type": "string"
        },
        "points": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MetroPoint"
          },
          "type": "array"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tool": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "material",
        "method",
        "parameter"
      ],
      "type": "object"
    },
    "Observation": {
      "description": "A qualitative result: an inspection grade, a yes/no. Not a quantity, and never coerced to one.",
      "properties": {
        "after_run": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "license": {
          "anyOf": [
            {
              "$ref": "#/$defs/License"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "material": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
